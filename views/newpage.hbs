<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Puzzle Game</title>
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #ff9a9e, #fad0c4);
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    h1 {
      margin-top: 20px;
      font-size: 3rem;
      color: #fff;
      text-shadow: 2px 2px #444;
      animation: fadeIn 2s ease-in-out;
    }

    nav {
      margin: 15px 0;
    }

    nav a {
      text-decoration: none;
      background: #fff;
      color: #333;
      padding: 10px 15px;
      margin: 5px;
      border-radius: 8px;
      box-shadow: 2px 2px 5px rgba(0,0,0,0.2);
      transition: all 0.3s ease-in-out;
    }

    nav a:hover {
      background: #ff6f61;
      color: #fff;
      transform: scale(1.1);
    }

    .puzzle {
      background: rgba(255, 255, 255, 0.85);
      margin: 20px;
      padding: 20px;
      border-radius: 15px;
      box-shadow: 4px 4px 10px rgba(0,0,0,0.3);
      width: 300px;
      text-align: center;
      animation: bounceIn 1s;
    }

    .scrambledWord {
      font-size: 2rem;
      color: #ff6f61;
      letter-spacing: 3px;
      margin: 10px 0;
      font-weight: bold;
    }

    .hint {
      font-size: 0.9rem;
      color: #555;
      margin-bottom: 10px;
      font-style: italic;
    }

    input.userInput {
      padding: 8px;
      border-radius: 8px;
      border: 2px solid #ff6f61;
      outline: none;
      margin-top: 10px;
      width: 80%;
      text-align: center;
      font-size: 1rem;
    }

    button {
      margin-top: 10px;
      padding: 8px 15px;
      border: none;
      border-radius: 8px;
      background: #ff6f61;
      color: #fff;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    button:hover {
      background: #e63946;
    }

    .result {
      font-weight: bold;
      margin-top: 10px;
    }

    #timer {
      font-size: 1.5rem;
      margin: 20px;
      color: #fff;
      padding: 10px 20px;
      background: rgba(0,0,0,0.4);
      border-radius: 12px;
    }

    #specialMessage {
      font-size: 1.5rem;
      color: black;
      font-weight: bold;
      margin: 20px;
      animation: pulse 1s infinite alternate;
    }

    /* Animations */
    @keyframes fadeIn {
      from {opacity: 0;}
      to {opacity: 1;}
    }

    @keyframes bounceIn {
      0% { transform: scale(0.8); opacity: 0; }
      50% { transform: scale(1.05); opacity: 1; }
      100% { transform: scale(1); }
    }

    @keyframes pulse {
      from { transform: scale(1); }
      to { transform: scale(1.2); }
    }
  </style>
</head>
<body>
  <h1>Word Puzzle Game</h1>
  <nav>
    <a href="/">Home</a>
    <a href="/level2">Level 2</a>
    <a href="/title">Title</a>
    <a href="/login">Login</a>
    <a href="/jokes">Joke Section</a>
  </nav>

  <!-- Puzzle 1 -->
  <div class="puzzle">
    <h2>Puzzle 1</h2>
    <p class="scrambledWord">NUTDO</p>
    <p class="hint">🍩 Sweet circular treat</p>
    <input type="text" class="userInput" placeholder="Enter your answer">
    <button onclick="checkAnswer(0)">Check</button>
    <p class="result"></p>
  </div>

  <!-- Puzzle 2 -->
  <div class="puzzle">
    <h2>Puzzle 2</h2>
    <p class="scrambledWord">YPTNOH</p>
    <p class="hint">🐍 Popular programming language</p>
    <input type="text" class="userInput" placeholder="Enter your answer">
    <button onclick="checkAnswer(1)">Check</button>
    <p class="result"></p>
  </div>

  <!-- Puzzle 3 -->
  <div class="puzzle">
    <h2>Puzzle 3</h2>
    <p class="scrambledWord">IEBRBA</p>
    <p class="hint">🎀 Famous doll brand</p>
    <input type="text" class="userInput" placeholder="Enter your answer">
    <button onclick="checkAnswer(2)">Check</button>
    <p class="result"></p>
  </div>

  <!-- Timer -->
  <div id="timer">Timer: 00:00</div>
  <!-- Special message -->
  <div id="specialMessage"></div>

  <script>
    const correctWords = ["DONUT", "PYTHON", "BARBIE"];
    const puzzleCount = correctWords.length;
    let startTime = null;
    let timerInterval = null;
    let solvedPuzzles = 0;

    function startTimer() {
      startTime = new Date().getTime();
      timerInterval = setInterval(updateTimer, 1000);
    }

    function updateTimer() {
      const currentTime = new Date().getTime();
      const elapsedTime = currentTime - startTime;
      const minutes = Math.floor((elapsedTime % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((elapsedTime % (1000 * 60)) / 1000);
      document.getElementById("timer").innerText = `Timer: ${formatTime(minutes)}:${formatTime(seconds)}`;
    }

    function formatTime(time) {
      return time < 10 ? "0" + time : time;
    }

    function checkAnswer(puzzleIndex) {
      const userInput = document.getElementsByClassName("userInput")[puzzleIndex].value.toUpperCase();
      const correctWord = correctWords[puzzleIndex];
      const resultElement = document.getElementsByClassName("result")[puzzleIndex];

      if (userInput === correctWord) {
        if (resultElement.innerHTML !== "🎉 Correct!") {
          solvedPuzzles++;
        }
        resultElement.innerHTML = "🎉 Correct!";
        resultElement.style.color = "green";
      } else {
        resultElement.innerHTML = "❌ Incorrect. Try again.";
        resultElement.style.color = "red";
      }

      // If all solved, stop timer and check time
      if (solvedPuzzles === puzzleCount) {
        clearInterval(timerInterval);
        const totalTime = (new Date().getTime() - startTime) / 1000; // seconds
        if (totalTime < 60) {
          document.getElementById("specialMessage").innerText = "⚡ Wow! Speed Bonus: Solved in under 1 minute!";
        } else {
          document.getElementById("specialMessage").innerText = "✅ All puzzles solved!";
        }
      }
    }

    startTimer();
  </script>
</body>
</html>
