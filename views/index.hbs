<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task Manager</title>

  <style>
    /* Reset some defaults */
    body, h1, ul, li, table, th, td, form {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background: #f7f9fc;
      color: #333;
      padding: 20px;
    }

    /* Navbar */
    ul {
      display: flex;
      justify-content: center;
      list-style: none;
      background: #0077cc;
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 30px;
    }

    li a {
      display: block;
      padding: 14px 20px;
      color: #fff;
      text-decoration: none;
      transition: background 0.3s;
    }

    li a:hover {
      background: #005fa3;
    }

    /* Header */
    h1 {
      text-align: center;
      margin-bottom: 20px;
      color: #0077cc;
    }

    /* Form styling */
    form[action="/add"] {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    form[action="/add"] input, 
    form[action="/add"] button {
      padding: 10px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 14px;
    }

    form[action="/add"] input:focus {
      outline: none;
      border-color: #0077cc;
      box-shadow: 0 0 4px rgba(0, 119, 204, 0.5);
    }

    form[action="/add"] button {
      background: #0077cc;
      color: #fff;
      border: none;
      cursor: pointer;
      transition: background 0.3s;
    }

    form[action="/add"] button:hover {
      background: #005fa3;
    }

    /* Table styling */
    table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    th, td {
      padding: 12px 16px;
      text-align: left;
    }

    th {
      background: #0077cc;
      color: #fff;
      cursor: pointer;
    }

    tr:nth-child(even) {
      background: #f9f9f9;
    }

    td form {
      display: inline-block;
      margin: 0 2px;
    }

    td form button {
      padding: 6px 12px;
      font-size: 13px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.2s;
    }

    td form button:first-of-type {
      background: #28a745;
      color: #fff;
    }

    td form button:first-of-type:hover {
      background: #218838;
    }

    td form button:last-of-type {
      background: #dc3545;
      color: #fff;
    }

    td form button:last-of-type:hover {
      background: #c82333;
    }
  </style>

  <script>
    /* same table sorting function you already had */
    function sortTable(n) {
      var table, rows, switching, i, x, y, shouldSwitch, dir, switchcount = 0;
      table = document.getElementById("taskTable");
      switching = true;
      dir = "asc";
      while (switching) {
        switching = false;
        rows = table.rows;
        for (i = 1; i < (rows.length - 1); i++) {
          shouldSwitch = false;
          x = rows[i].getElementsByTagName("TD")[n];
          y = rows[i + 1].getElementsByTagName("TD")[n];
          if (dir === "asc") {
            if (n === 2) {
              if (parseInt(x.innerHTML) > parseInt(y.innerHTML)) {
                shouldSwitch = true; break;
              }
            } else {
              if (x.innerHTML.toLowerCase() > y.innerHTML.toLowerCase()) {
                shouldSwitch = true; break;
              }
            }
          } else if (dir === "desc") {
            if (n === 2) {
              if (parseInt(x.innerHTML) < parseInt(y.innerHTML)) {
                shouldSwitch = true; break;
              }
            } else {
              if (x.innerHTML.toLowerCase() < y.innerHTML.toLowerCase()) {
                shouldSwitch = true; break;
              }
            }
          }
        }
        if (shouldSwitch) {
          rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
          switching = true;
          switchcount++;
        } else {
          if (switchcount === 0 && dir === "asc") {
            dir = "desc";
            switching = true;
          }
        }
      }
    }
  </script>
</head>
<body>
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="/newpage">Puzzle Challenge Level 1</a></li>
    <li><a href="/level2">Level 2</a></li>
    <li><a href="/title">Title</a></li>
    <li><a href="/login">Login</a></li>
    <li><a href="/jokes">Joke</a></li>
  </ul>

  <h1>Task Manager</h1>

  <form action="/add" method="post">
    <input type="text" name="title" placeholder="Task Title" required>
    <input type="text" name="description" placeholder="Task Description" required>
    <input type="number" name="rating" min="1" max="5" placeholder="Rating (1-5)" required>
    <button type="submit">Add Task</button>
  </form>

  <table id="taskTable">
    <thead>
      <tr>
        <th onclick="sortTable(0)">Title</th>
        <th onclick="sortTable(1)">Description</th>
        <th onclick="sortTable(2)">Rating</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      {{#each tasks}}
      <tr>
        <td>{{this.title}}</td>
        <td>{{this.description}}</td>
        <td>{{this.rating}}</td>
        <td>
          <form action="/complete/{{@index}}" method="post">
            <button type="submit">Complete</button>
          </form>
          <form action="/delete/{{@index}}" method="post">
            <button type="submit">Delete</button>
          </form>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</body>
</html>
